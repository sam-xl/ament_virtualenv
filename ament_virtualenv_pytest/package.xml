<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ament_virtualenv_pytest</name>
  <version>0.0.0</version>
  <description>pytest plugin to run tests in environment generated by ament_virtualenv</description>
  <maintainer email="J.C.vanBrakel@tudelft.nl">Jasper van Brakel</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ament_virtualenv</exec_depend>
  <exec_depend>python3-pytest</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <architecture_indendent/>
    <build_type>ament_python</build_type>
  </export>
</package>
